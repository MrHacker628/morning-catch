# Uploaded fish photos live here. Images only — nothing in this folder
# may ever be executed, whatever its name.

# Deny anything that could be run, on every server
<FilesMatch "\.(php|phps|phar|phtml|pht|inc|pl|py|cgi|sh|bash|html?|htaccess)$">
    Require all denied
</FilesMatch>

# And switch the PHP engine off where mod_php is in use.
# Guarded, because PHP-FPM / LiteSpeed servers 500 on a bare php_flag.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
